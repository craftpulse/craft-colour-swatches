{% import "_includes/forms" as forms %}

{% set defaultValue = null %}
{% set options = field.useConfigFile
    ? palettes[field.palette] is defined
        ? palettes[field.palette]
        : field.palette == ''
            ? configOptions
            : []
    : field.options
%}

{% if options|length == 0 %}
    <p>{{ "The selected colour palette for this field isn\'t defined in the `colour-swatches.php` config file or settings."|t('colour-swatches') }}</p>
{% endif %}

<div id="{{ id }}" class="color-swatches">
    {# fetch our color options #}
    {% for option in options %}
        {% include 'colour-swatches/colourOption' with {
            optionId: namespacedId ~ '-option-' ~ loop.index,
            option: option,
        } %}

        {# Set the default value with handle #}
        {% if option.default %}
            {% set optionHandle = option.handle ?? (option.label|kebab) %}
            {% set value = {
                label: option.label,
                color: option.color is defined ? option.color : option.colour,
                handle: optionHandle,
            } %}
            {% set defaultValue = value|json_encode %}
        {% endif %}
    {% endfor %}

    {# Prepare field value - ensure handle is included if it exists #}
    {% if fieldValue.color is defined %}
        {# fieldValue is already a model object with all properties #}
        {% set fieldValueData = {
            label: fieldValue.label,
            color: fieldValue.color,
            class: fieldValue.class,
            default: fieldValue.default,
        } %}
        {# Include handle if it exists #}
        {% if fieldValue.handle is defined and fieldValue.handle %}
            {% set fieldValueData = fieldValueData|merge({handle: fieldValue.handle}) %}
        {% endif %}
        {% set fieldValue = fieldValueData|json_encode %}
    {% else %}
        {% set fieldValue = '' %}
    {% endif %}

    {% set fieldValue = fieldValue ? fieldValue : defaultValue %}
</div>

{{ forms.hidden({
    id: id ~ namespacedId,
    name: name,
    value: fieldValue,
    class: 'color-swatches-input'})
}}
